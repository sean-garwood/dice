// Cloudflare Worker config for the Ten Thousand multiplayer backend.
// See docs/PROTOCOL.md for the client/server contract.
{
  "name": "dice10k-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed Durable Objects — required for the Workers Free plan.
      "new_sqlite_classes": ["Room"]
    }
  ]
}
